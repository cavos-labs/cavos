# Public application configuration
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase access
SUPABASE_SERVICE_ROLE_KEY=

# End-user authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Firebase signing and email authentication
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_RSA_KID=
FIREBASE_RSA_PRIVATE_KEY=
FIREBASE_RSA_PUBLIC_KEY=
EMAIL_OTP_PEPPER=

# Google Confidential Space social recovery
GCP_RECOVERY_PROJECT_ID=
GCP_RECOVERY_PROJECT_NUMBER=
GCP_RECOVERY_CONTROL_SERVICE_ACCOUNT=
GCP_RECOVERY_VERCEL_WIF_POOL_ID=cavos-vercel-control
GCP_RECOVERY_VERCEL_WIF_PROVIDER_ID=vercel-production
GCP_RECOVERY_ZONE=us-central1-a
GCP_RECOVERY_ZONES=us-central1-a,us-central1-b,us-central1-c,us-central1-f
GCP_RECOVERY_MACHINE_TYPE=n2d-highcpu-2
GCP_RECOVERY_WORKLOAD_SERVICE_ACCOUNT=
GCP_RECOVERY_WORKLOAD_IMAGE=
GCP_RECOVERY_WORKLOAD_IMAGE_DIGEST=sha256:
GCP_RECOVERY_KMS_KEY_NAME=
GCP_RECOVERY_WIF_AUDIENCE=
GCP_RECOVERY_ATTESTATION_AUDIENCE=https://cavos.xyz/api/recovery/social/attestation
GCP_RECOVERY_CONTROL_PLANE_URL=https://cavos.xyz
# Empty one-shot Confidential Space workers kept ready platform-wide (1-4).
SOCIAL_RECOVERY_WARM_POOL_SIZE=1

# Wallet address derivation
# Per-app salts are derived from CAVOS_BASE_SALT. Must be set to a unique hex
# value in production (e.g., 0x<random-256-bits>). Leaving this unset or using
# 0x0 in production is insecure. Once set, do not rotate — doing so would change
# all derived wallet addresses.
CAVOS_BASE_SALT=

# Starknet
STARKNET_RPC_URL=
STARKNET_RPC_SEPOLIA=
STARKNET_RPC_MAINNET=
NEXT_PUBLIC_STARKNET_RPC_URL=
JWKS_ADMIN_ADDRESS_SEPOLIA=
JWKS_ADMIN_PRIVATE_KEY_SEPOLIA=
JWKS_ADMIN_ADDRESS_MAINNET=
JWKS_ADMIN_PRIVATE_KEY_MAINNET=
GAS_TANK_CONTRACT_ADDRESS=
NEXT_PUBLIC_GAS_TANK_CONTRACT_ADDRESS=
NEXT_PUBLIC_STRK_TOKEN_ADDRESS=
PAYMASTER_WEBHOOK_SECRET=
PAYMASTER_WEBHOOK_SECRET_SEPOLIA=

# Solana relayer
SOLANA_RELAYER_SECRET_KEY=
SOLANA_DEVICE_ACCOUNT_PROGRAM_ID=
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_GAS_ENFORCE_MODE=warn

# Stellar relayer
# Master seed for the Stellar relayer. Per-org sponsor G-accounts are derived
# from this (SEP-0005 m/44'/148'/{index}'); the secret is never stored in the DB.
STELLAR_RELAYER_SECRET=
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org

# Billing
ONVO_SECRET_KEY=
NEXT_PUBLIC_ONVO_PUBLIC_KEY=
NEXT_PUBLIC_ONVO_BASE_URL=
