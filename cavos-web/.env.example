ONVO_WEBHOOK_SECRET=

# Email, operations, and scheduled jobs
RESEND_API_KEY=
ADMIN_API_KEY=
CRON_SECRET=
WEBHOOK_ENCRYPTION_KEY=

# Legacy compatibility only
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
